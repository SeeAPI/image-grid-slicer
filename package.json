{
  "name": "@seeapi/image-grid-slicer",
  "version": "0.1.0",
  "description": "A browser-native image grid slicer with uniform, adjustable guide, and deformable mesh modes.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "SeeAPI",
  "repository": {
    "type": "git",
    "url": "https://github.com/SeeAPI/image-grid-slicer.git"
  },
  "homepage": "https://seeapi.github.io/image-grid-slicer/",
  "bugs": {
    "url": "https://github.com/SeeAPI/image-grid-slicer/issues"
  },
  "keywords": [
    "image-grid-slicer",
    "image-slicer",
    "image-splitter",
    "grid-splitter",
    "canvas",
    "react",
    "sprite-sheet",
    "sticker-sheet",
    "mesh"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:lib": "tsup && node scripts/copy-css.mjs",
    "build:demo": "vite build",
    "build": "npm run typecheck && npm run build:lib && npm run build:demo",
    "preview": "vite preview",
    "pack:dry": "npm pack --dry-run"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
